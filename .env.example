# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_PUBLIC_APP_URL=https://vendamais.odontoart.com

# Public QR flow (frontend)
# Optional: when configured, the identification screen renders Cloudflare Turnstile.
VITE_TURNSTILE_SITE_KEY=
# Official App do Associado store URLs. Keep empty until the official URLs are confirmed.
VITE_ASSOCIADO_APP_STORE_URL=
VITE_ASSOCIADO_GOOGLE_PLAY_URL=

# IMPORTANT: backend values below must be configured as Supabase Edge Function Secrets,
# never as VITE_* variables and never committed with real values.
#
# LEMMIT_API_KEY=ADICIONAR_TOKEN
# LEMMIT_ENDPOINT=http://189.84.127.130:8080/webhook/...
# ERP_TOKEN=ADICIONAR_TOKEN
# ERP_BASE_URL=https://odontoart.s4e.com.br
# ERP_URL=https://odontoart.s4e.com.br/api/vendedor/NovoUsuario2
# SMTP_USERNAME=contratos@odontoart.com.br
# SMTP_PASSWORD=SENHA_DE_APLICATIVO_GOOGLE
# SMTP_FROM=contratos@odontoart.com.br
# TURNSTILE_SECRET_KEY=
